---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, collectTags } from '../lib/catalog';

const products = await getProducts();
const tags = collectTags(products);
---

<Base>
  <section class="intro">
    <h1>Catálogo</h1>
    <p class="lead">
      Explora nuestros productos de impresión 3D. Busca por nombre o categoría,
      o filtra con las etiquetas.
    </p>
  </section>

  <div class="catalog-toolbar">
    <form class="search" role="search" onsubmit="return false">
      <label class="visually-hidden" for="catalog-search">
        Buscar productos por nombre o categoría
      </label>
      <input
        id="catalog-search"
        type="search"
        name="q"
        placeholder="Buscar por nombre o categoría…"
        autocomplete="off"
        enterkeyhint="search"
      />
    </form>

    {
      tags.length > 0 && (
        <nav class="filters" aria-label="Filtrar por categoría">
          <ul class="filter-list" id="tag-filters">
            <li>
              <button
                type="button"
                class="chip chip-filter is-active"
                data-tag="__all__"
                aria-pressed="true"
              >
                Todos
              </button>
            </li>
            {tags.map((t) => (
              <li>
                <button
                  type="button"
                  class="chip chip-filter"
                  data-tag={t}
                  aria-pressed="false"
                >
                  {t}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  {
    products.length === 0 ? (
      <p class="empty">
        Aún no hay productos. Añade uno en <code>src/content/products/</code>.
      </p>
    ) : (
      <>
        <div class="grid" id="product-grid">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
        <p class="empty" id="no-results" hidden>
          No hay productos que coincidan con la búsqueda o las categorías.
        </p>
      </>
    )
  }
</Base>

<style>
  .intro {
    margin-bottom: 1.25rem;
  }
  .lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0;
  }
  .catalog-toolbar {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .search {
    width: 100%;
  }
  .search input {
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
    box-shadow: var(--shadow-sm);
  }
  .search input::placeholder {
    color: var(--text-muted);
  }
  .search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(55, 170, 174, 0.2);
  }
  .filters {
    margin: 0;
  }
  .filter-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    /* En móviles muy angostos permite scroll horizontal cómodo. */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .chip-filter {
    cursor: pointer;
    min-height: 40px;
    font-size: 0.9rem;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .chip-filter:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip-filter.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: clamp(1rem, 3vw, 1.5rem);
  }
  .empty {
    color: var(--text-muted);
    padding: 2rem 0;
  }
</style>

<script>
  // Búsqueda por título o tags + filtro por categorías, todo en el cliente.
  // La búsqueda es insensible a mayúsculas y acentos. Tags y texto se combinan
  // (AND): el producto debe coincidir con el texto y con alguna categoría activa.
  const filterBar = document.getElementById('tag-filters');
  const grid = document.getElementById('product-grid');
  const noResults = document.getElementById('no-results');
  const searchInput = document.getElementById(
    'catalog-search'
  ) as HTMLInputElement | null;

  function normalize(value: string): string {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  if (grid) {
    const buttons = filterBar
      ? Array.from(filterBar.querySelectorAll<HTMLButtonElement>('.chip-filter'))
      : [];
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    const selected = new Set<string>();

    function setPressed(btn: HTMLButtonElement, on: boolean) {
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', String(on));
    }

    function apply() {
      const query = normalize(searchInput?.value ?? '');
      let visible = 0;
      for (const card of cards) {
        const title = card.dataset.title || '';
        const tags = (card.dataset.tags || '')
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean);
        const matchesSearch =
          query.length === 0 ||
          normalize(title).includes(query) ||
          tags.some((t) => normalize(t).includes(query));
        const matchesTags =
          selected.size === 0 || tags.some((t) => selected.has(t));
        const show = matchesSearch && matchesTags;
        card.hidden = !show;
        if (show) visible++;
      }
      if (noResults) noResults.hidden = visible !== 0;
    }

    searchInput?.addEventListener('input', apply);

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        if (!tag) return;
        if (tag === '__all__') {
          selected.clear();
        } else if (selected.has(tag)) {
          selected.delete(tag);
        } else {
          selected.add(tag);
        }
        for (const b of buttons) {
          if (b.dataset.tag === '__all__') {
            setPressed(b, selected.size === 0);
          } else {
            setPressed(b, selected.has(b.dataset.tag || ''));
          }
        }
        apply();
      });
    }
  }
</script>
