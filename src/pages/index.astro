---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, collectTags } from '../lib/catalog';
import { site, whatsappRequestLink } from '../data/site';

const products = await getProducts();
const tags = collectTags(products);
const requestWa = whatsappRequestLink();
---

<Base>
  <section class="intro">
    <h1>Catálogo</h1>
    <p class="lead">
      Explora nuestros productos de impresión 3D. Busca por nombre o categoría,
      filtra con las etiquetas y ordénalos por nombre o precio.
    </p>
  </section>

  <div class="catalog-toolbar">
    <div class="toolbar-row">
    <form class="search" role="search" onsubmit="return false">
      <label class="visually-hidden" for="catalog-search">
        Buscar productos por nombre o categoría
      </label>
      <input
        id="catalog-search"
        type="search"
        name="q"
        placeholder="Buscar por nombre o categoría…"
        autocomplete="off"
        enterkeyhint="search"
      />
    </form>

    {
      products.length > 0 && (
        <div class="sort">
          <label for="catalog-sort">Ordenar por</label>
          <select id="catalog-sort" name="orden">
            <option value="catalogo">Orden sugerido</option>
            <optgroup label="Nombre">
              <option value="az">De la A a la Z</option>
              <option value="za">De la Z a la A</option>
            </optgroup>
            <optgroup label="Precio">
              <option value="barato">Del más barato al más caro</option>
              <option value="caro">Del más caro al más barato</option>
            </optgroup>
          </select>
        </div>
      )
    }
    </div>

    {
      tags.length > 0 && (
        <nav class="filters" aria-label="Filtrar por categoría">
          <ul class="filter-list" id="tag-filters">
            <li>
              <button
                type="button"
                class="chip chip-filter is-active"
                data-tag="__all__"
                aria-pressed="true"
              >
                Todos
              </button>
            </li>
            {tags.map((t) => (
              <li>
                <button
                  type="button"
                  class="chip chip-filter"
                  data-tag={t}
                  aria-pressed="false"
                >
                  {t}
                </button>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  {
    products.length === 0 ? (
      <p class="empty">
        Aún no hay productos. Añade uno en <code>src/content/products/</code>.
      </p>
    ) : (
      <>
        <script is:inline>
          (function () {
            try {
              var params = new URLSearchParams(location.search);
              var por = Number(params.get('por'));
              var pagina = Number(params.get('pagina')) || 1;
              if (pagina > 1 || (por && por !== 12)) {
                document.documentElement.classList.add('catalog-defer');
              }
            } catch (e) {}
          })();
        </script>
        <div class="grid" id="product-grid">
          {products.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
        <nav
          class="pagination"
          id="catalog-pagination"
          aria-label="Paginación del catálogo"
          hidden
        >
          <p class="pagination-status" id="pagination-status"></p>
          <div class="pagination-bar">
            <div class="page-size">
              <label for="catalog-page-size">Mostrar</label>
              <select id="catalog-page-size" name="por">
                <option value="12" selected>12 por página</option>
                <option value="24">24 por página</option>
                <option value="48">48 por página</option>
                <option value="96">96 por página</option>
              </select>
            </div>
            <div class="page-nav" id="page-nav"></div>
          </div>
        </nav>
        <div class="empty empty-request" id="no-results" hidden>
          <p>
            No encontramos lo que buscas. Si no está en el catálogo, escríbenos
            y lo creamos para ti.
          </p>
          {
            requestWa && (
              <a
                class="btn btn-whatsapp"
                id="no-results-wa"
                href={requestWa}
                data-phone={site.whatsapp}
                target="_blank"
                rel="noopener"
              >
                Escríbenos por WhatsApp
              </a>
            )
          }
        </div>
      </>
    )
  }
</Base>

<style>
  .intro {
    margin-bottom: 1.25rem;
  }
  .lead {
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0;
  }
  .catalog-toolbar {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .toolbar-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .search {
    width: 100%;
    flex: 1;
  }
  .search input {
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
    box-shadow: var(--shadow-sm);
  }
  .search input::placeholder {
    color: var(--text-muted);
  }
  .search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(55, 170, 174, 0.2);
  }
  .sort label {
    display: block;
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .sort select {
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
    box-shadow: var(--shadow-sm);
  }
  .sort select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(55, 170, 174, 0.2);
  }
  @media (min-width: 760px) {
    .toolbar-row {
      flex-direction: row;
      align-items: flex-end;
    }
    .sort {
      width: min(100%, 22rem);
      flex: 0 0 auto;
    }
  }
  .filters {
    margin: 0;
  }
  .filter-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    /* En móviles muy angostos permite scroll horizontal cómodo. */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .chip-filter {
    cursor: pointer;
    min-height: 40px;
    font-size: 0.9rem;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .chip-filter:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip-filter.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: clamp(1rem, 3vw, 1.5rem);
  }
  .pagination {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .pagination[hidden] {
    display: none;
  }
  .pagination-status {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .pagination-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
  }
  .page-size label {
    display: block;
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .page-size select {
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
    box-shadow: var(--shadow-sm);
  }
  .page-size select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(55, 170, 174, 0.2);
  }
  .empty {
    color: var(--text-muted);
    padding: 2rem 0;
  }
  .empty-request {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 40rem;
  }
  .empty-request[hidden] {
    display: none;
  }
  .empty-request p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
  }
</style>

<style is:global>
  /* .card vive en ProductCard, así que estas reglas van sin el atributo
     de alcance de esta página. Antes del script solo se pintan 12. */
  html.catalog-defer #product-grid .card {
    display: none !important;
  }
  #product-grid:not(.is-paged) .card:nth-child(n + 13) {
    display: none;
  }
  .catalog-toolbar {
    scroll-margin-top: 5.5rem;
  }
  /* Los botones de página se crean con JavaScript y no heredan el alcance de Astro. */
  #page-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  #page-nav .page-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }
  #page-nav .page-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  #page-nav .page-btn.is-current {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  #page-nav .page-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  #page-nav .page-ellipsis {
    min-width: 1.5rem;
    text-align: center;
    color: var(--text-muted);
  }
</style>

<script>
  // Búsqueda, filtro, orden y paginación, todo en el cliente.
  // Por defecto se muestran 12 productos. El resto queda oculto para que el
  // navegador no descargue sus fotos hasta cambiar de página.
  // La búsqueda es insensible a mayúsculas y acentos. Tags y texto se combinan
  // (AND): el producto debe coincidir con el texto y con alguna categoría activa.
  //
  // Enlaces para QR / compartir:
  //   /?tags=juguete
  //   /?tags=juguete,plantas
  const filterBar = document.getElementById('tag-filters');
  const grid = document.getElementById('product-grid');
  const noResults = document.getElementById('no-results');
  const searchInput = document.getElementById(
    'catalog-search'
  ) as HTMLInputElement | null;
  const sortSelect = document.getElementById(
    'catalog-sort'
  ) as HTMLSelectElement | null;
  const pageSizeSelect = document.getElementById(
    'catalog-page-size'
  ) as HTMLSelectElement | null;
  const pagination = document.getElementById('catalog-pagination');
  const paginationStatus = document.getElementById('pagination-status');
  const pageNav = document.getElementById('page-nav');
  const sortModes = new Set(['catalogo', 'az', 'za', 'barato', 'caro']);
  const pageSizes = [12, 24, 48, 96];
  let pageSize = 12;
  let page = 1;

  function normalize(value: string): string {
    return value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  if (grid) {
    const buttons = filterBar
      ? Array.from(filterBar.querySelectorAll<HTMLButtonElement>('.chip-filter'))
      : [];
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
    cards.forEach((card, index) => {
      card.dataset.catalogIndex = String(index);
    });
    const knownTags = new Map<string, string>();
    for (const btn of buttons) {
      const tag = btn.dataset.tag;
      if (tag && tag !== '__all__') knownTags.set(normalize(tag), tag);
    }
    const selected = new Set<string>();

    function setPressed(btn: HTMLButtonElement, on: boolean) {
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', String(on));
    }

    function syncButtons() {
      for (const b of buttons) {
        if (b.dataset.tag === '__all__') {
          setPressed(b, selected.size === 0);
        } else {
          setPressed(b, selected.has(b.dataset.tag || ''));
        }
      }
    }

    function compareTitle(a: HTMLElement, b: HTMLElement): number {
      return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'es', {
        sensitivity: 'base',
      });
    }

    function priceOf(card: HTMLElement): number | null {
      const raw = card.dataset.price;
      if (raw == null || raw === '') return null;
      const value = Number(raw);
      return Number.isFinite(value) ? value : null;
    }

    function sortCards() {
      const mode = sortSelect?.value || 'catalogo';
      const sorted = [...cards].sort((a, b) => {
        if (mode === 'az') return compareTitle(a, b);
        if (mode === 'za') return compareTitle(b, a);
        if (mode === 'barato' || mode === 'caro') {
          const pa = priceOf(a);
          const pb = priceOf(b);
          if (pa == null && pb == null) return compareTitle(a, b);
          if (pa == null) return 1;
          if (pb == null) return -1;
          if (pa !== pb) return mode === 'barato' ? pa - pb : pb - pa;
          return compareTitle(a, b);
        }
        return Number(a.dataset.catalogIndex) - Number(b.dataset.catalogIndex);
      });
      for (const card of sorted) grid.appendChild(card);
    }

    function cardMatches(card: HTMLElement, query: string): boolean {
      const title = card.dataset.title || '';
      const tags = (card.dataset.tags || '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean);
      const matchesSearch =
        query.length === 0 ||
        normalize(title).includes(query) ||
        tags.some((t) => normalize(t).includes(query));
      const matchesTags =
        selected.size === 0 || tags.some((t) => selected.has(t));
      return matchesSearch && matchesTags;
    }

    function visiblePageNumbers(current: number, total: number): Array<number | '…'> {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const wanted = new Set<number>([1, total, current - 1, current, current + 1]);
      if (current <= 3) {
        wanted.add(2);
        wanted.add(3);
        wanted.add(4);
      }
      if (current >= total - 2) {
        wanted.add(total - 1);
        wanted.add(total - 2);
        wanted.add(total - 3);
      }
      const nums = [...wanted].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
      const out: Array<number | '…'> = [];
      let prev = 0;
      for (const n of nums) {
        if (prev && n - prev > 1) out.push('…');
        out.push(n);
        prev = n;
      }
      return out;
    }

    function renderPager(total: number, pageCount: number, start: number) {
      if (!pagination || !paginationStatus || !pageNav) return;
      if (total === 0) {
        pagination.hidden = true;
        pageNav.replaceChildren();
        return;
      }
      pagination.hidden = false;
      const end = Math.min(start + pageSize, total);
      paginationStatus.textContent =
        pageCount === 1
          ? `Mostrando ${total} ${total === 1 ? 'producto' : 'productos'}`
          : `Mostrando ${start + 1}–${end} de ${total}`;

      pageNav.replaceChildren();

      function addButton(
        label: string,
        target: number,
        options: { disabled?: boolean; current?: boolean; labelText?: string } = {}
      ) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'page-btn';
        button.textContent = label;
        if (options.current) {
          button.classList.add('is-current');
          button.setAttribute('aria-current', 'page');
        }
        button.setAttribute(
          'aria-label',
          options.labelText || (options.current ? `Página ${target}` : `Ir a la página ${target}`)
        );
        button.disabled = Boolean(options.disabled);
        if (!options.disabled && !options.current) {
          button.addEventListener('click', () => {
            page = target;
            apply({ scroll: true });
            writeUrl();
          });
        }
        pageNav?.append(button);
      }

      addButton('Anterior', page - 1, {
        disabled: page <= 1,
        labelText: 'Página anterior',
      });
      for (const item of visiblePageNumbers(page, pageCount)) {
        if (item === '…') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'page-ellipsis';
          ellipsis.textContent = '…';
          ellipsis.setAttribute('aria-hidden', 'true');
          pageNav.append(ellipsis);
        } else {
          addButton(String(item), item, { current: item === page });
        }
      }
      addButton('Siguiente', page + 1, {
        disabled: page >= pageCount,
        labelText: 'Página siguiente',
      });
    }

    function apply(options: { resetPage?: boolean; scroll?: boolean } = {}) {
      if (options.resetPage) page = 1;
      sortCards();
      const order = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
      const query = normalize(searchInput?.value ?? '');
      const matched: HTMLElement[] = [];
      for (const card of order) {
        if (cardMatches(card, query)) matched.push(card);
        else card.hidden = true;
      }
      const pageCount = Math.max(1, Math.ceil(matched.length / pageSize));
      if (page > pageCount) page = pageCount;
      if (page < 1) page = 1;
      const start = (page - 1) * pageSize;
      matched.forEach((card, index) => {
        card.hidden = index < start || index >= start + pageSize;
      });
      renderPager(matched.length, matched.length === 0 ? 0 : pageCount, start);
      grid.classList.add('is-paged');
      document.documentElement.classList.remove('catalog-defer');
      if (noResults) noResults.hidden = matched.length !== 0;
      if (options.scroll) {
        document.querySelector('.catalog-toolbar')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }
      const wa = document.getElementById(
        'no-results-wa'
      ) as HTMLAnchorElement | null;
      if (wa) {
        const typed = searchInput?.value.trim() ?? '';
        const detail = typed ? ` Busqué: "${typed}".` : '';
        const text = `Hola ToDo3D, no encontré lo que busco en el catálogo.${detail} ¿Pueden crearlo?`;
        wa.href = `https://wa.me/${wa.dataset.phone || ''}?text=${encodeURIComponent(text)}`;
      }
    }

    function writeUrl() {
      const params = new URLSearchParams(window.location.search);
      if (selected.size > 0) {
        params.set('tags', [...selected].join(','));
      } else {
        params.delete('tags');
        params.delete('categorias');
      }
      const query = searchInput?.value.trim() ?? '';
      if (query) params.set('q', query);
      else params.delete('q');
      const orden = sortSelect?.value || 'catalogo';
      if (orden !== 'catalogo') params.set('orden', orden);
      else params.delete('orden');
      if (page > 1) params.set('pagina', String(page));
      else params.delete('pagina');
      if (pageSize !== 12) params.set('por', String(pageSize));
      else params.delete('por');
      const next = params.toString();
      const url = next ? `${window.location.pathname}?${next}` : window.location.pathname;
      history.replaceState(null, '', url);
    }

    function readUrl() {
      const params = new URLSearchParams(window.location.search);
      const raw =
        params.get('tags') ||
        params.get('categorias') ||
        '';
      selected.clear();
      for (const part of raw.split(',')) {
        const known = knownTags.get(normalize(part));
        if (known) selected.add(known);
      }
      const q = params.get('q');
      if (q && searchInput) searchInput.value = q;
      const orden = params.get('orden') || 'catalogo';
      if (sortSelect && sortModes.has(orden)) sortSelect.value = orden;
      const por = Number(params.get('por'));
      if (pageSizes.includes(por)) {
        pageSize = por;
        if (pageSizeSelect) pageSizeSelect.value = String(por);
      }
      const pagina = Number(params.get('pagina'));
      if (Number.isInteger(pagina) && pagina > 0) page = pagina;
    }

    readUrl();
    syncButtons();
    apply();
    writeUrl();

    searchInput?.addEventListener('input', () => {
      apply({ resetPage: true });
      writeUrl();
    });

    sortSelect?.addEventListener('change', () => {
      apply({ resetPage: true });
      writeUrl();
    });

    pageSizeSelect?.addEventListener('change', () => {
      const next = Number(pageSizeSelect.value);
      if (!pageSizes.includes(next)) return;
      pageSize = next;
      apply({ resetPage: true });
      writeUrl();
    });

    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        if (!tag) return;
        if (tag === '__all__') {
          selected.clear();
        } else if (selected.has(tag)) {
          selected.delete(tag);
        } else {
          selected.add(tag);
        }
        syncButtons();
        apply({ resetPage: true });
        writeUrl();
      });
    }
  }
</script>
