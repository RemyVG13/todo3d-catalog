---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada">
  <section class="notfound">
    <h1>404</h1>
    <p>La página que buscas no existe o el producto fue retirado.</p>
    <a class="btn btn-primary" href="/">Ir al catálogo</a>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    padding: 3rem 0;
  }
  .notfound h1 {
    font-size: clamp(3rem, 12vw, 6rem);
    margin: 0;
    color: var(--accent);
  }
  .notfound p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
</style>
