---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import fullLogo from '../../logos/full_logo_nobackground.png';
import isologo from '../../logos/isologo_nobackground.png';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} - inicio`}>
      {/* Escritorio: logo completo con leyenda. Móvil: isologo compacto. */}
      <Image
        src={fullLogo}
        alt={`${site.name} - ${site.tagline}`}
        class="logo logo-full"
        widths={[220, 320]}
        sizes="220px"
        loading="eager"
      />
      <Image
        src={isologo}
        alt={site.name}
        class="logo logo-compact"
        widths={[120, 160]}
        sizes="120px"
        loading="eager"
      />
    </a>
  </div>
</header>

<style>
  /* Chrome claro: los logos PNG están pensados para fondo blanco. */
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .logo {
    height: auto;
    width: auto;
    object-fit: contain;
  }
  .logo-full {
    display: none;
    max-height: 56px;
  }
  .logo-compact {
    display: block;
    max-height: 48px;
  }
  @media (min-width: 640px) {
    .logo-full {
      display: block;
    }
    .logo-compact {
      display: none;
    }
  }
</style>
